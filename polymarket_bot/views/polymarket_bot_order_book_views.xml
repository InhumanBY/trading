<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_book_snapshot_list" model="ir.ui.view">
        <field name="name">polymarket_bot.order_book_snapshot.list</field>
        <field name="model">polymarket_bot.order_book_snapshot</field>
        <field name="arch" type="xml">
            <list string="Order Book Snapshots" default_order="snapshot_time desc">
                <field name="snapshot_time"/>
                <field name="market_id"/>
                <field name="token_side"/>
                <field name="book_side"/>
                <field name="level"/>
                <field name="price"/>
                <field name="size"/>
                <field name="source"/>
            </list>
        </field>
    </record>

    <record id="action_order_book_snapshot" model="ir.actions.act_window">
        <field name="name">Order Book Depth</field>
        <field name="res_model">polymarket_bot.order_book_snapshot</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
