<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mcp_setup_assistant_action" model="ir.actions.client">
        <field name="name">MCP Setup Assistant</field>
        <field name="tag">svn_mcp_server.setup_assistant</field>
    </record>

    <menuitem
        id="mcp_menu_setup"
        name="Setup Assistant"
        parent="mcp_menu_root"
        action="mcp_setup_assistant_action"
        sequence="5"
        groups="svn_mcp_server.group_mcp_admin"/>

    <record id="mcp_open_settings_action" model="ir.actions.client">
        <field name="name">Configuration</field>
        <field name="tag">svn_mcp_server.open_mcp_settings</field>
    </record>

    <menuitem
        id="mcp_menu_configuration"
        name="Configuration"
        parent="mcp_menu_root"
        action="mcp_open_settings_action"
        sequence="1"
        groups="svn_mcp_server.group_mcp_admin"/>
</odoo>
